# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# ─── OpenRouter ───────────────────────────────────────────────────────────────
# Clé API OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Git — identité des commits agentiques ────────────────────────────────────
# Utilisé par git-bridge pour signer tous les commits de la plateforme.
# Seul endroit où configurer l'identité git.
GIT_AUTHOR_NAME=agentic-platform
GIT_AUTHOR_EMAIL=agentic@platform.local